# Copy to .env and fill in. .env is git-ignored. Never put the service role key in a browser or app.
SUPABASE_URL=http://127.0.0.1:8810
SUPABASE_SERVICE_ROLE_KEY=
# Long random string the team uses to read the inbox: openssl rand -hex 24
TEAM_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

BUSINESS_NAME=Orbit Desks
BUSINESS_CONTEXT=We sell electric standing desks and office furniture to businesses and home workers in the UK.

# Comma-separated sites allowed to post the form, or *
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_MINUTE=5
